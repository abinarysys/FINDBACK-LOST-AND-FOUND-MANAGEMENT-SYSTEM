<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <link rel="stylesheet" href="/css/login.css">
    <title>LOGIN</title>
</head>
<body>
    <div class="nav">
        <div class="logo">
            <img src="/img/logo.png" alt="FindBack Logo">
        </div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href=#>Browse Items</a>
            <a href=#>How It Works</a>
            <a href=#>Contact Us</a>
        </div>
        <div class="right-buttons">
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Get Started</a>
        </div>
    </div>
    <img src="/img/logo.png" alt="FindBack Logo">
    <h2>Welcome to FindBack</h2>
    <p>Login to continue finding what matters</p>
    <form action="/auth/loginUser" method="POST">
        <label>Email</label>
        <input type="email" name="email" placeholder="ex. juandelacrus@email.com" required>
        <label>Password</label>
        <input type="password" name="pw" placeholder="ex. jkb3H98#nd" required>
        <button type="submit">Log In</button>
    </form>
</body>
</html>