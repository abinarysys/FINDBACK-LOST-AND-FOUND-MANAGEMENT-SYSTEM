<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <link rel="stylesheet" href="/css/register.css">
    <title>REGISTER</title>
</head>
<body>
    <img src="/img/logo.png" alt="FindBack Logo">
    <h2>Create Your Account</h2>
    <p>Join FindBack and help reunite lost items!</p>
    <form action="/auth/registerUser" method="POST" enctype="multipart/form-data">
        <label>Profile Picture</label>
        <input type="file" name="pfp" required>
        <label>Full Name</label>
        <input type="text" name="name" placeholder="ex. Juan De La Cruz" required>
        <label>Email Addresss</label>
        <input type="email" name="email" placeholder="ex. juandelacruz@email.com" required>
        <label>Password</label>
        <input type="password" name="pw" placeholder="ex. x1w23WLm9" required>
        <button type="submit">Submit</button>
    </form>
    <p>Already have an account?<a href="/auth/login">Login Here</a></p>
    <% if (success && success.length > 0) { %>
        <div class="alert success">
            <%= success[0] %>
        </div>
    <% } %>

    <% if (error && error.length > 0) { %>
        <div class="alert error">
            <%= error[0] %>
        </div>
    <% } %>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on('connect', () => {
            console.log('Connected to FINDBACK Socket.IO!');
        });
    </script>
</body>
</html> 