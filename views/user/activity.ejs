<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Activity | FindBack</title>

    <link rel="stylesheet" href="/css/user/sidebar.css">
    <link rel="stylesheet" href="/css/user/profile.css">
    <link rel="stylesheet" href="/css/user/activity.css">
</head>
<body>
<%
    const when = (d) => {
        const x = new Date(d);
        return isNaN(x) ? '—' : x.toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    };
%>
    <div class="dashboard-layout">

        <!-- Sidebar -->
        <%- include('partials/user-sidebar', {
            user: user,
            activePage: 'activity'
        }) %>

        <!-- Main Content -->
        <div class="page-main">

            <!-- Navbar -->
            <%- include('partials/navbar', { user: user }) %>

            <main class="profile-page">

                <!-- Page Heading -->
                <div class="page-heading">
                    <div>
                        <p class="eyebrow">ACCOUNT</p>
                        <h1>My Activity</h1>
                        <p>Everything you've reported on FindBack, newest first.</p>
                    </div>
                </div>

                <!-- Summary -->
                <section class="act-stats">
                    <div class="act-stat">
                        <span>Total posts</span>
                        <strong><%= stats.total %></strong>
                    </div>
                    <div class="act-stat">
                        <span>Lost reports</span>
                        <strong><%= stats.lost %></strong>
                    </div>
                    <div class="act-stat">
                        <span>Found reports</span>
                        <strong><%= stats.found %></strong>
                    </div>
                </section>

                <!-- Timeline -->
                <section class="act-panel">
                    <div class="act-toolbar">
                        <div class="act-filters" role="group" aria-label="Filter activity">
                            <button type="button" class="act-pill active" data-type="all">All</button>
                            <button type="button" class="act-pill" data-type="lost">Lost</button>
                            <button type="button" class="act-pill" data-type="found">Found</button>
                        </div>
                        <label class="act-search">
                            <input type="search" id="actSearch" placeholder="Search your activity" aria-label="Search your activity" autocomplete="off">
                        </label>
                    </div>

                    <ul class="act-list" id="actList">
                        <% activities.forEach(a => { %>
                            <li class="act-item"
                                data-type="<%= a.type %>"
                                data-search="<%= [a.title, a.category_name, a.location, a.status].filter(Boolean).join(' ').toLowerCase() %>">
                                <span class="act-dot act-dot-<%= a.type %>" aria-hidden="true"></span>
                                <div class="act-body">
                                    <div class="act-top">
                                        <p class="act-text">
                                            You reported a <strong><%= a.type %></strong> item:
                                            <a href="/item/<%= a.type %>/<%= a.itemId %>"><%= a.title %></a>
                                        </p>
                                        <span class="act-badge act-badge-<%= a.type %>"><%= a.type === 'lost' ? 'Lost' : 'Found' %></span>
                                    </div>
                                    <p class="act-meta">
                                        <% if (a.category_name) { %><span><%= a.category_name %></span><% } %>
                                        <% if (a.location) { %><span><%= a.location %></span><% } %>
                                        <% if (a.status) { %><span class="act-status"><%= a.status %></span><% } %>
                                    </p>
                                    <time class="act-time"><%= when(a.created_at) %></time>
                                </div>
                            </li>
                        <% }) %>
                    </ul>

                    <div class="act-empty" id="actEmpty" <%= activities.length ? 'hidden' : '' %>>
                        <p><strong>No activity yet.</strong></p>
                        <p>When you report a lost or found item, it will show up here.</p>
                        <a href="/lost" class="edit-button">Report an item</a>
                    </div>

                    <div class="act-foot"><span id="actCount"><%= activities.length %> records</span></div>
                </section>

            </main>
        </div>
    </div>

    <script>
        (function () {
            const items = Array.from(document.querySelectorAll('.act-item'));
            const pills = Array.from(document.querySelectorAll('.act-pill'));
            const input = document.getElementById('actSearch');
            const empty = document.getElementById('actEmpty');
            const count = document.getElementById('actCount');
            let type = 'all';

            function apply() {
                const q = input.value.trim().toLowerCase();
                let n = 0;
                items.forEach(li => {
                    const ok = (type === 'all' || li.dataset.type === type) && (!q || li.dataset.search.includes(q));
                    li.hidden = !ok;
                    if (ok) n++;
                });
                pills.forEach(p => p.classList.toggle('active', p.dataset.type === type));
                count.textContent = n + (n === 1 ? ' record' : ' records');
                if (items.length) empty.hidden = n !== 0;
            }
            pills.forEach(p => p.addEventListener('click', () => { type = p.dataset.type; apply(); }));
            input.addEventListener('input', apply);
        })();
    </script>
</body>
</html>
