<%
    const initial = user.full_name ? user.full_name.charAt(0).toUpperCase() : 'U';
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile | FindBack</title>

    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/user-ui.css">
    <link rel="stylesheet" href="/css/user/user-shell.css">
</head>
<body>
    <%- include('partials/user-header', { user: user, activePage: 'profile' }) %>

    <main class="u-main">

        <% (typeof success !== 'undefined' ? success : []).forEach(function (msg) { %>
            <div class="alert alert-success" role="status"><%= msg %></div>
        <% }) %>
        <% (typeof error !== 'undefined' ? error : []).forEach(function (msg) { %>
            <div class="alert alert-error" role="alert"><%= msg %></div>
        <% }) %>

        <header class="page-head">
            <div>
                <h1>Edit Profile</h1>
                <p>Update your name, contact number and profile photo.</p>
            </div>
        </header>

        <!-- Field names (full_name, contact_number, profile_image) match POST /user/profile/update -->
        <form class="grid-2" method="post" action="/user/profile/update" enctype="multipart/form-data">

            <article class="panel">
                <div class="panel-head">
                    <div>
                        <h2>Personal Information</h2>
                        <p>These details are shown on your profile</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="field">
                        <label for="full_name">Full name</label>
                        <input class="input" type="text" id="full_name" name="full_name"
                               value="<%= user.full_name || '' %>" maxlength="100" required autocomplete="name">
                    </div>

                    <div class="field">
                        <label for="email">Email address</label>
                        <input class="input" type="email" id="email" value="<%= user.email || '' %>" disabled>
                        <span class="help">Your email is your login, so it can't be changed here.</span>
                    </div>

                    <div class="field">
                        <label for="contact_number">Contact number</label>
                        <input class="input" type="tel" id="contact_number" name="contact_number"
                               value="<%= user.contact_number || '' %>" maxlength="11" inputmode="tel"
                               required autocomplete="tel">
                        <span class="help">Up to 11 digits.</span>
                    </div>
                </div>
                <div class="panel-foot" style="justify-content:flex-end">
                    <a class="btn btn-ghost" href="/user/profile">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </article>

            <article class="panel">
                <div class="panel-head">
                    <div>
                        <h2>Profile Photo</h2>
                        <p>Shown on your profile and account menu</p>
                    </div>
                </div>
                <div class="panel-body user-hero">
                    <% if (user.profile_image) { %>
                        <img class="avatar av-lg" id="avatarPreview" src="<%= user.profile_image %>" alt="Current profile photo">
                    <% } else { %>
                        <span class="avatar av-lg" id="avatarInitial"><%= initial %></span>
                        <img class="avatar av-lg" id="avatarPreview" alt="New profile photo preview" hidden>
                    <% } %>

                    <label class="btn btn-ghost btn-block" for="profile_image" style="cursor:pointer">Choose a new photo</label>
                    <input type="file" id="profile_image" name="profile_image" accept="image/*" class="sr-only">
                    <span class="help" id="fileName">No new photo selected.</span>
                </div>
            </article>
        </form>
    </main>

    <script>
    (function () {
        var input = document.getElementById('profile_image');
        var preview = document.getElementById('avatarPreview');
        var initial = document.getElementById('avatarInitial');
        var label = document.getElementById('fileName');

        input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            if (!file) { label.textContent = 'No new photo selected.'; return; }
            if (file.type.indexOf('image/') !== 0) {
                input.value = '';
                label.textContent = 'Please choose an image file.';
                return;
            }
            preview.src = URL.createObjectURL(file);
            preview.hidden = false;
            if (initial) initial.hidden = true;
            label.textContent = file.name;
        });
    })();
    </script>
</body>
</html>
