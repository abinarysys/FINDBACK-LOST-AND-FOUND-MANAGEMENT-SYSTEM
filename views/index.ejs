<%# File guide: This template renders the i nd ex page or partial as server-generated HTML. Inputs are locals passed by its route/controller; output is HTML. Shared partials and browser assets are linked here or injected by app.js. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/user/tokens.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/user/scroll-reveal.css?v=4">
    <script src="/js/scroll-reveal.js?v=4" defer></script>
    <style>
        body.page-home .home-scroll-reveal {
            opacity: 0;
            transform: translate3d(0, 38px, 0) scale(.975);
            filter: blur(2px);
            transition: opacity 650ms ease-out, transform 780ms cubic-bezier(.2,.75,.25,1), filter 650ms ease-out;
            transition-delay: var(--home-reveal-delay, 0ms);
            will-change: opacity, transform, filter;
        }
        body.page-home .home-scroll-reveal.home-scroll-visible {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
        @media (prefers-reduced-motion: reduce) {
            body.page-home .home-scroll-reveal { transition-duration: 280ms !important; }
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <title>FINDBACK</title>
</head>
<body class="page-home" data-theme-aware>

    <%- include('user/partials/navbar', { user: user }) %>

    <% if (success && success.length > 0) { %>
        <div class="flash-message flash-success">
            <span class="flash-icon">✓</span>
            <span class="flash-text"><%= success[0] %></span>
            <button type="button" class="flash-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
    <% } %>

    <% if (error && error.length > 0) { %>
        <div class="flash-message flash-error">
            <span class="flash-icon">!</span>
            <span class="flash-text"><%= error[0] %></span>
            <button type="button" class="flash-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
    <% } %>

    <!-- HERO -->
    <div class="top-layer">
        <div class="left">
            <div class="header">
                <h3>Lost something?</h3>
                <h3>Let's find it back</h3>
                <p>Report lost or found items and help reunite them with their owners.</p>
            </div>

            <form class="search" action="/browse" method="GET" role="search">
                <label class="sr-only" for="homeSearch">Search lost and found items</label>
                <input id="homeSearch" name="q" type="search" placeholder="Search an item or place" maxlength="80">
                <button type="submit">Search</button>
            </form>

            <div class="lostFound-button">
                <a href="/lost">
                    <div class="lost-button">
                        <div class="search-icon">
                            <img src="/img/icon/search.png" alt="Search icon">
                        </div>
                        <div class="text">
                            <h4>SUBMIT LOST ITEM</h4>
                            <p>For users who lost an item<br>and want to report it.</p>
                        </div>
                    </div>
                </a>
                <a href="/found">
                    <div class="found-button">
                        <div class="search-icon">
                            <img src="/img/icon/box.png" alt="Box icon">
                        </div>
                        <div class="text">
                            <h4>SUBMIT FOUND ITEM</h4>
                            <p>For users who found an item<br>and want to report it.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <div class="right">
            <img src="/img/local-img/index.png" alt="FindBack's lost and found community illustration">
        </div>
    </div>

    <!-- CATEGORIES -->
    <div class="categories">
        <% categories.forEach(category => { %>
            <a href="/<%= category.category_name %>">
                <%- include('partials/category-icon', { name: category.category_name }) %>
                <p><%= category.category_name %></p>
            </a>
        <% }) %>
    </div>

    <!-- RECENT ITEMS -->
    <div class="recent-items">
        <div class="recent-head">
            <div>
                <h3>Recent Lost &amp; Found Items</h3>
                <p>Check out the latest items reported by our users!</p>
            </div>
            <a href="/browse" class="view-all-btn">View All &rarr;</a>
        </div>

        <div class="items-container">
            <% recentItems.slice(0, 4).forEach(item => { %>
                <div class="item-card <%= item.isClaimed ? 'is-claimed' : '' %>">
                    <div class="item-picture">
                        <% if (item.picture) { %>
                            <img src="<%= item.picture %>" alt="<%= item.item_name %>">
                        <% } %>

                        <% if (item.isClaimed) { %>
                            <span class="item-label claimed">CLAIMED</span>
                        <% } else if (item.type === 'lost') { %>
                            <span class="item-label lost">LOST</span>
                        <% } else { %>
                            <span class="item-label found">FOUND</span>
                        <% } %>
                    </div>

                    <div class="item-details">
                        <h4><%= item.item_name %></h4>
                        <p><b>Reported by:</b> <%= item.reporterName || 'Unknown' %></p>
                        <p><b>Contact Number:</b> <%= item.reporterContact || 'Not provided' %></p>
                        <p><b>Category:</b> <%= item.category_name || 'Not specified' %></p>
                        <p><b>Description:</b> <%= item.description || 'No description provided' %></p>
                        <p><b>Location Lost/Found:</b> <%= item.location || 'Not specified' %></p>
                        <p><b>Date Lost/Found:</b> <%= item.itemDate || 'Not specified' %></p>
                        <p><b>Date Posted:</b> <%= item.postedAt || 'Not specified' %></p>
                    </div>

                    <div class="item-actions">
                        <% if (item.isClaimed) { %>
                            <span class="claim-btn disabled" aria-disabled="true">Already Claimed</span>
                        <% } else { %>
                            <a href="/claim/<%= item.type %>/<%= item.type === 'lost' ? item.lost_item_id : item.found_item_id %>" class="claim-btn">
                                Make a Claim
                            </a>
                        <% } %>
                        <a href="/user/chat/start/<%= item.type %>/<%= item.type === 'lost' ? item.lost_item_id : item.found_item_id %>" class="message-btn">Message</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- FEEDBACK FORM -->
    <section class="feedback">
        <h2>Help us make FINDBACK better. Share your ideas with us!</h2>
        <form action="/fb/feedback" method="POST" class="feedback-form">
            <div class="stars">
                <input type="radio" id="s5" name="rate" value="5" required>
                <label for="s5">&#9733;</label>
                <input type="radio" id="s4" name="rate" value="4">
                <label for="s4">&#9733;</label>
                <input type="radio" id="s3" name="rate" value="3">
                <label for="s3">&#9733;</label>
                <input type="radio" id="s2" name="rate" value="2">
                <label for="s2">&#9733;</label>
                <input type="radio" id="s1" name="rate" value="1">
                <label for="s1">&#9733;</label>
            </div>
            <textarea name="msg" placeholder="Enter your feedback here" required></textarea>
            <button type="submit">Submit Feedback</button>
        </form>
    </section>

    <!-- CUSTOMER FEEDBACK: one card per feedback -->
    <section class="feedback-list">
        <h3>Customer Feedback</h3>
        <p class="feedback-sub">Know that your feedbacks are prioritized!</p>

        <% if (feedbackList && feedbackList.length > 0) { %>
            <div class="feedback-row">
                <% feedbackList.forEach(fList => { %>
                    <article class="feedback-card">
                        <p><b>Sender:</b> <%= fList.full_name %></p>
                        <p><b>Rating:</b> <%= fList.rating %></p>
                        <p><b>Message:</b> <%= fList.message %></p>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <p class="feedback-empty">No feedback yet. Be the first to share your thoughts!</p>
        <% } %>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="help-band">
            <div class="help-item help-main">
                <span class="help-icon"><img src="/img/icon/email.png" alt="Email icon"></span>
                <div>
                    <h4>Need Help? We're Here for You.</h4>
                    <p>Have a question, concern, or need help with a lost or found item? Contact us.</p>
                </div>
            </div>
            <div class="help-item">
                <span class="help-icon"><img src="/img/icon/email.png" alt="Email icon"></span>
                <span class="help-label">Email</span>
            </div>
            <div class="help-item">
                <span class="help-icon"><img src="/img/icon/location.png" alt="Location icon"></span>
                <span class="help-label">Location</span>
            </div>
            <div class="help-item">
                <span class="help-icon"><img src="/img/icon/contact.png" alt="Phone icon"></span>
                <span class="help-label">Contact</span>
            </div>
            <a href="/contacts" class="help-btn">Contact Us &rarr;</a>
        </div>

        <div class="footer-bar">
            <h4>FindBack</h4>
            <p>Helping people reunite with their lost belongings.</p>
        </div>
    </footer>
    <script>
    (function () {
        var targets = document.querySelectorAll([
            ".page-home .top-layer > .left",
            ".page-home .top-layer > .right",
            ".page-home .categories > a",
            ".page-home .recent-head",
            ".page-home .item-card",
            ".page-home .feedback > h2",
            ".page-home .feedback-form",
            ".page-home .feedback-list > h3",
            ".page-home .feedback-list > .feedback-sub",
            ".page-home .feedback-card",
            ".page-home .feedback-empty",
            ".page-home .footer .help-band",
            ".page-home .footer .footer-bar"
        ].join(","));

        targets.forEach(function (element, index) {
            element.classList.add("home-scroll-reveal");
            element.style.setProperty("--home-reveal-delay", Math.min(index % 5, 3) * 55 + "ms");
        });

        if (!("IntersectionObserver" in window)) {
            targets.forEach(function (element) { element.classList.add("home-scroll-visible"); });
            return;
        }

        var revealObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                entry.target.classList.toggle("home-scroll-visible", entry.isIntersecting);
            });
        }, { threshold: 0.08, rootMargin: "0px 0px -7% 0px" });

        targets.forEach(function (element) { revealObserver.observe(element); });
    })();
    </script>
</body>
</html>
