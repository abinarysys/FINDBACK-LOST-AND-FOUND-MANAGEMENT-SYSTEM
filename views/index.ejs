<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/index.css">
    <title>FINDBACK</title>
</head>
<body>
    <div class="categories">
        <% categories.forEach(category => { %>
