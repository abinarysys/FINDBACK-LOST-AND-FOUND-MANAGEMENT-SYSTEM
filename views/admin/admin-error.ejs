<%# File guide: This template renders the a dm in e rr or page or partial as server-generated HTML. Inputs are locals passed by its route/controller; output is HTML. Shared partials and browser assets are linked here or injected by app.js. %>
<%- include('partials/head', { title: locals.title || 'Error' }) %>
<body>
<div class="error-page">
    <div>
        <div class="code"><%= locals.code || 500 %></div>
        <h1 style="margin:10px 0 6px"><%= locals.title || 'Something went wrong' %></h1>
        <p class="muted" style="margin-bottom:20px"><%= locals.message || 'Please try again.' %></p>
        <div class="btn-row" style="justify-content:center">
            <a class="btn btn-primary" href="/admin">Back to dashboard</a>
            <a class="btn btn-ghost" href="javascript:history.back()">Go back</a>
        </div>
    </div>
</div>
<%- include('partials/foot') %>
