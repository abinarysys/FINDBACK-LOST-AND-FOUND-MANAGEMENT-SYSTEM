```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Activity Logs | FindBack Admin</title>

    <link rel="stylesheet" href="/css/admin-sidebar.css">
    <link rel="stylesheet" href="/css/admin-activity-logs.css">
</head>
<body>

    <!-- EXISTING SIDEBAR: DO NOT CHANGE -->
    <%- include('partials/admin-sidebar', {
        activePage: 'activity-logs'
    }) %>

    <main class="admin-main">

        <div class="page-heading">
            <h1>Activity Logs</h1>
        </div>

        <!-- Search and Export -->
        <section class="logs-toolbar">
            <div class="search-box">
                <input
                    type="search"
                    id="logSearch"
                    placeholder="Search"
                    aria-label="Search user records"
                >
                <span class="search-icon">⌕</span>
            </div>

            <button
                type="button"
                class="export-btn"
                onclick="window.print()"
            >
                Export Logs <span>›</span>
            </button>
        </section>

        <!-- SUMMARY CARDS -->
        <section class="logs-summary">

            <article class="log-summary-card">
                <div class="summary-icon">▣</div>
                <p>ID Numbers</p>
                <h2><%= logs.length %></h2>
            </article>

            <article class="log-summary-card">
                <div class="summary-icon">♙</div>
                <p>Names</p>
                <h2>
                    <%= logs.filter(log => log.full_name).length %>
                </h2>
            </article>

            <article class="log-summary-card">
                <div class="summary-icon">✉</div>
                <p>Emails</p>
                <h2>
                    <%= logs.filter(log => log.email).length %>
                </h2>
            </article>

        </section>

        <!-- TABLE AND STATUS -->
        <section class="logs-content">

            <article class="logs-panel">
                <h2>Log Details</h2>

                <div class="logs-table-wrapper">
                    <table id="logsTable">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (logs && logs.length > 0) { %>

                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td><%= log.user_id %></td>

                                        <td>
                                            <%= log.full_name || 'N/A' %>
                                        </td>

                                        <td>
                                            <%= log.email || 'N/A' %>
                                        </td>

                                        <td>
                                            <% const status = String(log.account_status || 'Unknown').toLowerCase(); %>

                                            <span class="status-badge <%= status === 'active' ? 'active' : 'inactive' %>">
                                                <%= log.account_status || 'Unknown' %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="4" class="empty-state">
                                        No user records found.
                                    </td>
                                </tr>

                            <% } %>
                        </tbody>

                    </table>
                </div>

                <div class="table-footer">
                    <span id="resultsCount">
                        <%= logs.length %> user records
                    </span>
                </div>
            </article>

            <!-- STATUS CARD -->
            <article class="status-panel">

                <div class="status-icon">✓</div>

                <h3>Status</h3>

                <div class="status-stat">
                    <span>Active</span>
                    <strong>
                        <%= logs.filter(log =>
                            String(log.account_status || '').toLowerCase() === 'active'
                        ).length %>
                    </strong>
                </div>

                <div class="status-stat">
                    <span>Inactive</span>
                    <strong>
                        <%= logs.filter(log =>
                            String(log.account_status || '').toLowerCase() === 'inactive'
                        ).length %>
                    </strong>
                </div>

            </article>

        </section>

    </main>

    <!-- SEARCH FUNCTION -->
    <script>
        const searchInput = document.getElementById('logSearch');
        const tableRows = document.querySelectorAll(
            '#logsTable tbody tr'
        );
        const resultsCount = document.getElementById('resultsCount');

        searchInput.addEventListener('input', function () {
            const keyword = this.value.toLowerCase();
            let visibleCount = 0;

            tableRows.forEach(row => {
                const matches = row.innerText
                    .toLowerCase()
                    .includes(keyword);

                row.style.display = matches ? '' : 'none';

                if (matches && row.querySelector('td[colspan]') === null) {
                    visibleCount++;
                }
            });

            resultsCount.textContent =
                visibleCount + ' user records';
        });
    </script>

</body>
</html>
```