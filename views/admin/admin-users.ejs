```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Users | FindBack</title>
    <link rel="stylesheet" href="/css/admin-sidebar.css">
    <link rel="stylesheet" href="/css/admin-users.css">
</head>
<body>
<div class="admin-layout">

    <%- include('partials/admin-sidebar', { activePage: 'users' }) %>

    <main class="admin-main">
        <header class="page-heading">
            <h1>ADMIN MANAGE USERS</h1>
        </header>

        <section class="panel">
            <div class="panel-heading">
                <h2>
                    <span class="purple-icon">♟</span>
                    User Management
                </h2>

                <input
                    type="search"
                    id="userSearch"
                    class="admin-users-search"
                    placeholder="Search users..."
                    aria-label="Search users">
            </div>

            <div class="table-wrap">
                <table class="admin-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Date Created</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                    <% if (typeof users !== 'undefined' && users.length) { %>
                        <% users.forEach(user => {
                            const status = String(
                                user.account_status || 'unknown'
                            ).toLowerCase();

                            const isActive = status === 'active';

                            const isSelf = Number(user.user_id) === Number(
                                typeof currentAdminId !== 'undefined'
                                    ? currentAdminId
                                    : -1
                            );
                        %>
                            <tr>
                                <td><%= user.user_id %></td>

                                <td class="user-name">
                                    <%= user.full_name || '—' %>
                                </td>

                                <td><%= user.email || '—' %></td>

                                <td>
                                    <%= user.created_at
                                        ? new Date(user.created_at)
                                            .toLocaleDateString('en-US', {
                                                month: 'short',
                                                day: '2-digit',
                                                year: 'numeric'
                                            })
                                        : '—' %>
                                </td>

                                <td>
                                    <span class="status <%= status %>">
                                        <%= status === 'unknown'
                                            ? 'Unknown'
                                            : status.charAt(0).toUpperCase()
                                                + status.slice(1) %>
                                    </span>
                                </td>

                                <td>
                                    <div class="action-buttons">
                                        <button
                                            type="button"
                                            class="action-btn edit-btn view-user-btn"
                                            title="View user details"
                                            aria-label="View user details"
                                            data-id="<%= user.user_id %>"
                                            data-name="<%= user.full_name || '' %>"
                                            data-email="<%= user.email || '' %>"
                                            data-contact="<%= user.contact_number || '' %>"
                                            data-role="<%= user.role || 'user' %>"
                                            data-status="<%= status %>">
                                            ✎
                                        </button>

                                        <button
                                            type="button"
                                            class="action-btn <%= isActive ? 'deactivate-btn' : 'activate-btn' %> status-btn"
                                            title="<%= isActive ? 'Deactivate account' : 'Activate account' %>"
                                            aria-label="<%= isActive ? 'Deactivate account' : 'Activate account' %>"
                                            data-id="<%= user.user_id %>"
                                            data-name="<%= user.full_name || '' %>"
                                            data-status="<%= isActive ? 'inactive' : 'active' %>"
                                            <%= isSelf ? 'disabled' : '' %>>
                                            <%= isActive ? '⊘' : '✓' %>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="empty-state">
                                No users found.
                            </td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <p class="table-count" id="userCount">
                    Total users: <%= users ? users.length : 0 %>
                </p>

                <div class="pagination">
                    <button type="button" id="previousPage" disabled>
                        Previous
                    </button>
                    <span id="pageNumber">1</span>
                    <button type="button" id="nextPage" disabled>
                        Next
                    </button>
                </div>
            </div>
        </section>
    </main>
</div>

<script>
    const search = document.getElementById('userSearch');
    const tableBody = document.querySelector('#usersTable tbody');
    const count = document.getElementById('userCount');

    const previousPage = document.getElementById('previousPage');
    const nextPage = document.getElementById('nextPage');
    const pageNumber = document.getElementById('pageNumber');

    const rows = Array.from(tableBody.querySelectorAll('tr'))
        .filter(row => !row.querySelector('.empty-state'));

    const rowsPerPage = 10;
    let currentPage = 1;
    let filteredRows = [...rows];

    function renderTable() {
        const totalPages = Math.max(
            1,
            Math.ceil(filteredRows.length / rowsPerPage)
        );

        if (currentPage > totalPages) {
            currentPage = totalPages;
        }

        rows.forEach(row => {
            row.hidden = true;
        });

        const start = (currentPage - 1) * rowsPerPage;
        const visibleRows = filteredRows.slice(start, start + rowsPerPage);

        visibleRows.forEach(row => {
            row.hidden = false;
        });

        count.textContent = search.value
            ? 'Matching users: ' + filteredRows.length
            : 'Total users: ' + rows.length;

        pageNumber.textContent = currentPage;
        previousPage.disabled = currentPage <= 1;
        nextPage.disabled = currentPage >= totalPages;
    }

    search.addEventListener('input', function () {
        const term = this.value.trim().toLowerCase();

        filteredRows = rows.filter(row =>
            row.innerText.toLowerCase().includes(term)
        );

        currentPage = 1;
        renderTable();
    });

    previousPage.addEventListener('click', function () {
        if (currentPage > 1) {
            currentPage--;
            renderTable();
        }
    });

    nextPage.addEventListener('click', function () {
        if (currentPage < Math.ceil(filteredRows.length / rowsPerPage)) {
            currentPage++;
            renderTable();
        }
    });

    document.querySelectorAll('.view-user-btn').forEach(button => {
        button.addEventListener('click', function () {
            alert(
                'USER DETAILS\n\n' +
                'ID: ' + this.dataset.id + '\n' +
                'Name: ' + this.dataset.name + '\n' +
                'Email: ' + this.dataset.email + '\n' +
                'Contact: ' + this.dataset.contact + '\n' +
                'Role: ' + this.dataset.role + '\n' +
                'Status: ' + this.dataset.status
            );
        });
    });

    document.querySelectorAll('.status-btn').forEach(button => {
        button.addEventListener('click', async function () {
            const id = this.dataset.id;
            const name = this.dataset.name;
            const newStatus = this.dataset.status;
            const action = newStatus === 'active' ? 'activate' : 'deactivate';

            if (!confirm(
                'Are you sure you want to ' + action + ' ' + name + '?'
            )) {
                return;
            }

            try {
                const response = await fetch(
                    '/admin/users/' + encodeURIComponent(id) + '/status',
                    {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ status: newStatus })
                    }
                );

                const result = await response.json();

                if (!response.ok || !result.success) {
                    alert(result.message || 'Could not update account status.');
                    return;
                }

                alert('User account status updated successfully.');
                window.location.reload();
            } catch (error) {
                console.error('Update status error:', error);
                alert('Could not connect to the server. Please try again.');
            }
        });
    });

    renderTable();
</script>
</body>
</html>
