```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FindBack Admin | Analytics</title>

    <link rel="stylesheet" href="/css/admin-analytics.css">
    <link rel="stylesheet" href="/css/admin-sidebar.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <%- include('partials/admin-sidebar', { activePage: 'analytics' }) %>

    <main class="analytics-main">

        <header class="page-header">
            <div>
                <h1>Analytics</h1>
                <p>Monitor your lost and found system performance.</p>
            </div>
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <p>Active Users</p>
                <h2><%= (analytics && analytics.users && analytics.users.activeUsers) || 0 %></h2>
            </div>

            <div class="stat-card">
                <p>Items Found</p>
                <h2><%= (analytics && analytics.foundItems) || 0 %></h2>
            </div>

            <div class="stat-card">
                <p>Claims Approved</p>
                <h2><%= (analytics && analytics.claims && analytics.claims.approvedClaims) || 0 %></h2>
            </div>

            <div class="stat-card">
                <p>Pending Reviews</p>
                <h2><%= (analytics && analytics.claims && analytics.claims.pendingClaims) || 0 %></h2>
            </div>
        </section>

        <section class="analytics-panel monthly-panel">
            <div class="panel-heading">
                <div>
                    <h3>Lost and Found Items Over Time</h3>
                    <p>Monthly overview of reported items</p>
                </div>
                <span class="chart-period">12 Months</span>
            </div>

            <div class="chart-container">
                <canvas id="monthlyChart"></canvas>
            </div>
        </section>

        <section class="analytics-grid">

            <div class="analytics-panel category-panel">
                <div class="panel-heading">
                    <h3>Top Categories</h3>
                </div>

                <% if (analytics && analytics.categoryStats && analytics.categoryStats.length > 0) { %>
                    <% analytics.categoryStats.forEach(function(category) { %>
                        <div class="category-row">
                            <span class="category-dot"></span>

                            <span class="category-name">
                                <%= category.category_name || 'Uncategorized' %>
                            </span>

                            <span class="category-percentage">
                                <%= Number(category.percentage) || 0 %>%
                            </span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="empty-message">No categories available.</p>
                <% } %>
            </div>

            <div class="analytics-panel claims-panel">
                <div class="panel-heading">
                    <h3>Claims Review</h3>
                </div>

                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Category</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (analytics && analytics.recentClaims && analytics.recentClaims.length > 0) { %>
                                <% analytics.recentClaims.forEach(function(claim) { %>
                                    <tr>
                                        <td><%= claim.claim_id %></td>

                                        <td><%= claim.full_name || 'Unknown' %></td>

                                        <td><%= claim.category_name || 'Other' %></td>

                                        <td>
                                            <span class="status-badge <%= String(claim.status || 'pending').toLowerCase() %>">
                                                <%= claim.status || 'Pending' %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="empty-message">
                                        No claims available.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </section>

        <footer class="analytics-footer">
            FindBack Admin Dashboard &copy; <%= new Date().getFullYear() %>
        </footer>

    </main>

    <script id="monthlyData" type="application/json"><%- JSON.stringify((analytics && analytics.monthlyItems) || []) %></script>

    <script>
        const monthlyDataElement = document.getElementById('monthlyData');
        let monthlyData = [];

        try {
            monthlyData = JSON.parse(monthlyDataElement.textContent || '[]');
        } catch (error) {
            console.error('Unable to read monthly analytics data:', error);
        }

        const chartCanvas = document.getElementById('monthlyChart');

        if (chartCanvas && typeof Chart !== 'undefined') {
            new Chart(chartCanvas, {
                type: 'bar',

                data: {
                    labels: monthlyData.map(function(item) {
                        return item.label;
                    }),

                    datasets: [
                        {
                            label: 'Lost Items',
                            data: monthlyData.map(function(item) {
                                return Number(item.lostItems) || 0;
                            }),
                            backgroundColor: '#801cff',
                            borderRadius: 5,
                            barPercentage: 0.7,
                            categoryPercentage: 0.7
                        },
                        {
                            label: 'Found Items',
                            data: monthlyData.map(function(item) {
                                return Number(item.foundItems) || 0;
                            }),
                            backgroundColor: '#c05bcf',
                            borderRadius: 5,
                            barPercentage: 0.7,
                            categoryPercentage: 0.7
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            align: 'end',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'rectRounded',
                                boxWidth: 10,
                                boxHeight: 10,
                                padding: 18,
                                font: {
                                    size: 11
                                }
                            }
                        },

                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: '#777281',
                                font: {
                                    size: 11
                                }
                            },
                            border: {
                                display: false
                            }
                        },

                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                color: '#777281',
                                font: {
                                    size: 11
                                }
                            },
                            grid: {
                                color: '#f0edf5'
                            },
                            border: {
                                display: false,
                                dash: [4, 4]
                            }
                        }
                    }
                }
            });
        }
    </script>

</body>
</html>
```