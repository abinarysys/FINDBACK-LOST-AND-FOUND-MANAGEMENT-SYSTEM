<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Verification | FindBack Admin</title>
     <link rel="stylesheet" href="/css/admin-sidebar.css">
    <link rel="stylesheet" href="/css/admin-user-verification.css">

</head>
<body>

    <%- include('partials/admin-sidebar', { activePage: 'verification' }) %>

    <main class="main-content">
        <div class="page-title">
            <svg class="heading-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.1 0-7.5 2.1-7.5 4.7V21h15v-2.3c0-2.6-3.4-4.7-7.5-4.7Z"/>
            </svg>
            <h1>User Verification</h1>
        </div>

        <section class="verification-panel">
            <div class="table-container">
                <table class="verification-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Account Type</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (typeof users !== 'undefined' && users.length > 0) { %>
                            <% users.forEach(user => {
                                const id = user.user_id || user.id;
                                const name = user.full_name || '—';
                                const email = user.email || '—';
                                const accountType = user.account_type || user.role || 'Individual';
                                const submittedDate =
                                    user.verification_submitted_at ||
                                    user.submitted_at ||
                                    user.created_at;

                                const status = String(
                                    user.verification_status ||
                                    user.account_status ||
                                    'pending'
                                ).toLowerCase();
                            %>
                                <tr>
                                    <td><%= id %></td>
                                    <td><%= name %></td>
                                    <td><%= email %></td>
                                    <td><%= accountType %></td>
                                    <td>
                                        <%= submittedDate
                                            ? new Date(submittedDate).toLocaleDateString('en-US', {
                                                month: 'short',
                                                day: '2-digit',
                                                year: 'numeric'
                                            })
                                            : '—'
                                        %>
                                    </td>
                                    <td>
                                        <span class="status-badge status-<%= status.replace(/[^a-z0-9-]/g, '') %>">
                                            <%= status.charAt(0).toUpperCase() + status.slice(1) %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button
                                                type="button"
                                                class="icon-button edit-button"
                                                title="View details"
                                                aria-label="View verification details"
                                                data-id="<%= id %>"
                                                data-name="<%= name %>"
                                                data-email="<%= email %>"
                                                data-type="<%= accountType %>"
                                                data-submitted="<%= submittedDate || '' %>"
                                                data-status="<%= status %>">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 20h9"/>
                                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/>
                                                </svg>
                                            </button>

                                            <button
                                                type="button"
                                                class="icon-button delete-button"
                                                title="Delete action unavailable"
                                                aria-label="Delete action unavailable"
                                                disabled>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 6h18"/>
                                                    <path d="M8 6V4h8v2"/>
                                                    <path d="m19 6-1 14H6L5 6"/>
                                                    <path d="M10 11v5M14 11v5"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="empty-row">
                                    No verification records available.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <div class="modal-overlay" id="verificationModal">
        <div class="modal-card">
            <button type="button" class="modal-close" id="closeModal" aria-label="Close">&times;</button>
            <h2>User Verification Details</h2>

            <div class="modal-row"><span>ID</span><strong id="detailId">—</strong></div>
            <div class="modal-row"><span>Name</span><strong id="detailName">—</strong></div>
            <div class="modal-row"><span>Email</span><strong id="detailEmail">—</strong></div>
            <div class="modal-row"><span>Account Type</span><strong id="detailType">—</strong></div>
            <div class="modal-row"><span>Submitted</span><strong id="detailSubmitted">—</strong></div>
            <div class="modal-row"><span>Status</span><strong id="detailStatus">—</strong></div>
        </div>
    </div>

    <script>
        const verificationModal = document.getElementById('verificationModal');

        document.querySelectorAll('.edit-button').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('detailId').textContent = button.dataset.id || '—';
                document.getElementById('detailName').textContent = button.dataset.name || '—';
                document.getElementById('detailEmail').textContent = button.dataset.email || '—';
                document.getElementById('detailType').textContent = button.dataset.type || '—';

                const submitted = button.dataset.submitted;
                document.getElementById('detailSubmitted').textContent = submitted
                    ? new Date(submitted).toLocaleDateString('en-US', {
                        month: 'short',
                        day: '2-digit',
                        year: 'numeric'
                    })
                    : '—';

                const status = button.dataset.status || 'pending';
                document.getElementById('detailStatus').textContent =
                    status.charAt(0).toUpperCase() + status.slice(1);

                verificationModal.classList.add('show');
            });
        });

        document.getElementById('closeModal').addEventListener('click', () => {
            verificationModal.classList.remove('show');
        });

        verificationModal.addEventListener('click', event => {
            if (event.target === verificationModal) {
                verificationModal.classList.remove('show');
            }
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
                verificationModal.classList.remove('show');
            }
        });
    </script>

</body>
</html>