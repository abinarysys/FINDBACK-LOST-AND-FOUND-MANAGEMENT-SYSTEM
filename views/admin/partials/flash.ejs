<%# File guide: This template renders the f la sh page or partial as server-generated HTML. Inputs are locals passed by its route/controller; output is HTML. Shared partials and browser assets are linked here or injected by app.js. %>
<% const _ok = [].concat(locals.success || []).filter(Boolean);
   const _err = [].concat(locals.error || []).filter(Boolean); %>
<% _ok.forEach(function (m) { %>
    <div class="alert alert-success" role="status"><%- icon('check') %><span><%= m %></span><button type="button" class="close" aria-label="Dismiss">&times;</button></div>
<% }) %>
<% _err.forEach(function (m) { %>
    <div class="alert alert-error" role="alert"><%- icon('x') %><span><%= m %></span><button type="button" class="close" aria-label="Dismiss">&times;</button></div>
<% }) %>
