<%# File guide: This template renders the h ea d page or partial as server-generated HTML. Inputs are locals passed by its route/controller; output is HTML. Shared partials and browser assets are linked here or injected by app.js. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= locals.title ? title + ' | ' : '' %>FindBack Admin</title>

    <link rel="stylesheet" href="/css/admin.css">

    <!-- apply saved dark mode / accent colour before the page paints (no flash) -->
    <script>
        (function () {
            try {
                var r = document.documentElement;
                if (localStorage.getItem('fb-theme') === 'dark') r.dataset.theme = 'dark';
                var c = localStorage.getItem('fb-accent');
                if (c) r.style.setProperty('--primary', c);
            } catch (e) {}
        })();
    </script>
    <script src="/js/admin.js" defer></script>
</head>
