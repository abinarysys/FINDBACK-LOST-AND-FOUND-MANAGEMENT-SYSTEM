<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <link rel="stylesheet" href="/css/login.css">
    <title>LOGIN</title>
</head>
<body>
    <div class="nav">
        <div class="logo">
            <img src="/img/logo.png" alt="FindBack Logo">
        </div>
        <div class="nav-links">
             <a href="/">Home</a>
            <a href="/browse">Browse Items</a>
            <a href="/howitworks">How It Works</a>
            <a href="/contacts">Contact Us</a>
        </div>
        <div class="right-buttons">
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Get Started</a>
        </div>
    </div>
    <% if (success && success.length > 0) { %>
        <div class="flash-message flash-success">
            <span class="flash-icon">✓</span>
            <span class="flash-text"><%= success[0] %></span>
            <button type="button" class="flash-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="flash-message flash-error">
            <span class="flash-icon">!</span>
            <span class="flash-text"><%= error[0] %></span>
            <button type="button" class="flash-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
    <% } %> 
    <img src="/img/logo.png" alt="FindBack Logo">
    <h2>Welcome to FindBack</h2>
    <p>Login as admin to continue finding what matters</p>
    <form action="/admin/login/user" method="POST">
        <label>Email</label>
        <input type="email" name="email" placeholder="ex. juandelacrus@email.com" required>
        <label>Password</label>
        <input type="password" name="pw" placeholder="ex. jkb3H98#nd" required>
        <button type="submit">Log In</button>
        <label for="register">
    don't have a account?<a href="/admin/register">register here</a>
    </label>
    </form>
    
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on('connect', () => {
            console.log('Connected to FINDBACK Socket.IO!');
        });
    </script>
</body>
</html>